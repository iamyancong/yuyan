{
  "name": "yuyan-app",
  "version": "1.2.21",
  "private": true,
  "type": "module",
  "description": "雨燕平台桌面端 - 运维及部署工具",
  "scripts": {
    "dev": "node scripts/copy-node.js --dev && tauri dev",
    "build": "node scripts/copy-node.js && tauri build",
    "frontend:dev": "concurrently -n \"api,web\" -c \"green,blue\" \"node --watch server/index.mjs\" \"vite --host 127.0.0.1 --port 1420\"",
    "server:dev": "node --watch server/index.mjs",
    "frontend:build": "node --input-type=commonjs -e \"if(!process.env.CI){require('child_process').execSync('npx vue-tsc --noEmit',{stdio:'inherit'})}\" && vite build",
    "frontend:build:ci": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "test:server": "node --test server/services/tests/*.test.mjs",
    "test:central-url": "node --experimental-strip-types --test src/utils/centralUrlPolicy.test.ts",
    "mcp:build": "tsc -p mcp/tsconfig.json",
    "test:mcp": "pnpm run mcp:build && node --test mcp/tests/*.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@ant-design/icons-vue": "^7.0.1",
    "@babel/generator": "^8.0.0",
    "@babel/parser": "^8.0.0",
    "@babel/traverse": "^8.0.0",
    "@babel/types": "^8.0.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@tauri-apps/api": "^2.6.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2.2.0",
    "@vue/compiler-dom": "^3.5.38",
    "@vue/compiler-sfc": "^3.5.38",
    "@ycwang-dev/components": "^1.4.0",
    "@ycwang-dev/hooks": "^1.1.1",
    "@ycwang-dev/utils": "^1.0.5",
    "ant-design-vue": "^4.2.6",
    "axios": "^1.11.0",
    "compression": "^1.8.1",
    "connect-history-api-fallback": "^2.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "less": "^4.4.1",
    "monaco-editor": "0.54.0",
    "ssh2": "^1.17.0",
    "vue": "^3.5.18",
    "vue-router": "^4.0.0",
    "vxe-pc-ui": "^4.14.29",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.6.2",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "concurrently": "^10.0.3",
    "typescript": "~5.8.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^7.1.2",
    "vue-tsc": "^3.0.5"
  },
  "pnpm": {
    "overrides": {
      "numfmt": "3.2.4"
    }
  }
}
