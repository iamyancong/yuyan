{
  "identifier": "default",
  "description": "雨燕平台基础权限配置",
  "windows": [
    "main",
    "floating-notification"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:default",
    "process:allow-restart",
    "updater:default",
