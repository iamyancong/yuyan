{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "雨燕",
  "version": "1.0.0",
  "identifier": "cn.yuyan.ops",
  "build": {
    "beforeDevCommand": "pnpm run frontend:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run frontend:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "雨燕平台",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../server/**/*",
      "resources/bin/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
     ]
  }
}
