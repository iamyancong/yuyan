# 雨燕（Yuyan）环境变量配置示例
# 复制本文件为 .env 或 .env.local 后按需填写

# ===== 服务端配置（server/）=====
# 服务监听端口（独立启动时的默认端口，桌面端由 Tauri 动态分配）
PORT=3100
HOST=127.0.0.1

# 脚手架微应用模板仓库地址（Git HTTP/HTTPS 地址，默认使用官方 GitHub 开源模板）
TEMPLATE_REPO_URL=https://github.com/iamyancong/microapp-template-vue3.git
TEMPLATE_BRANCH=main

# GitLab 服务地址与访问 Token（用于自动在 GitLab 创建远程仓库与初始化推送）
GITLAB_HOST=
GITLAB_TOKEN=

# 服务端允许请求的 GitLab 地址白名单（逗号分隔，#62）。网页端鉴权、App 换票、提交信息补全、脚手架建仓只请求这些地址
# 未配置时按 GITLAB_HOST、VITE_GITLAB_HOST 与已有账号登录过的地址推导；中央服务（HOST=0.0.0.0）建议显式配置
# YUYAN_ALLOWED_GITLAB_HOSTS=http://gitlab.example.com

# Git 提交身份
GIT_USER_NAME=yuyan-ops
GIT_USER_EMAIL=yuyan-ops@example.com

# 部署凭据加密密钥（32 字节随机 Hex 字符串）
# 本机模式下默认自动生成并保存于数据目录；生产集中部署必须显式指定独立随机密钥
# DEPLOY_SECRET_KEY=

# ===== 前端配置（Vite）=====
# 纯前端浏览器联调时的后端 API 服务地址
VITE_APP_SERVER_URL=http://127.0.0.1:3100
VITE_LOCAL_SERVER_URL=http://127.0.0.1:3100

# 纯前端开发时的 GitLab 代理地址（可选）
# VITE_GITLAB_HOST=http://127.0.0.1:8081

# 技术支持联系人配置（工号/邮箱/名片未配置时界面隐藏对应项，只显示通用标题）
# 以下 6 个字段在 Vite 编译时写入产物，不是运行时配置；本地可放在 .env.local。
# 网页版（Docker 镜像）通过 docker build --build-arg 同名字段注入，见 README。
# 正式发版必须在 GitHub Actions Secrets 配置全部同名字段；release-tauri.yml
# 通过构建任务 env 直接注入（无需写入 .env）。dry-run 和发版均校验非空值、
# 姓名/工号/邮箱非占位值及有效的邮箱和 HTTP(S) 名片地址；请勿直接使用下方示例发版。
VITE_CONTACT_NAME="雨燕技术支持"
VITE_CONTACT_WORK_NO=""
VITE_CONTACT_COMPANY="赢时胜"
VITE_CONTACT_ROLE="雨燕研发与技术支持"
VITE_CONTACT_EMAIL=""
VITE_CONTACT_CARD_URL=""
