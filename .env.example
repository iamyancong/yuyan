# 雨燕（Yuyan）环境变量配置示例
# 复制本文件为 .env 或 .env.local 后按需填写

# ===== 服务端配置（server/）=====
# 服务监听端口（独立启动时的默认端口，桌面端由 Tauri 动态分配）
PORT=3100
HOST=127.0.0.1

# 脚手架微应用模板仓库地址（Git HTTP/HTTPS 地址）
TEMPLATE_REPO_URL=
TEMPLATE_BRANCH=template

# GitLab 服务地址与访问 Token（用于自动在 GitLab 创建远程仓库与初始化推送）
GITLAB_HOST=
GITLAB_TOKEN=

# Git 提交身份
GIT_USER_NAME=yuyan-ops
GIT_USER_EMAIL=yuyan-ops@example.com

# 部署凭据加密密钥（32 字节随机 Hex 字符串）
# 本机模式下默认自动生成并保存于数据目录；生产集中部署必须显式指定独立随机密钥
# DEPLOY_SECRET_KEY=

# ===== 前端配置（Vite）=====
# 纯前端浏览器联调时的后端 API 服务地址
VITE_APP_SERVER_URL=http://127.0.0.1:3100
VITE_LOCAL_SERVER_URL=http://127.0.0.1:3100

# 纯前端开发时的 GitLab 代理地址（可选）
# VITE_GITLAB_HOST=http://127.0.0.1:8081
